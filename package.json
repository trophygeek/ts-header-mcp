{
  "name": "ts-header-mcp",
  "version": "0.1.0",
  "description": "MCP server producing C-header-style signature views of TypeScript source, with line offsets, for AI coding agents",
  "type": "module",
  "bin": { "ts-header-mcp": "dist/server.js" },
  "main": "dist/server.js",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test \"test/unit/*.test.ts\"",
    "smoke-test": "tsx test/smoke.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "typescript": "^5.6.0 || ^6.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
