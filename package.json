{
  "name": "ts-header-mcp",
  "version": "0.1.0",
  "description": "MCP server producing C-header-style signature views of TypeScript source, with line offsets, for AI coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ts-header-mcp": "dist/server.js",
    "ts-header-cli": "dist/cli.js"
  },
  "main": "dist/server.js",
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "validate": "pnpm typecheck && pnpm lint --no-inline-config && pnpm test",
    "test": "pnpm typecheck && tsx --test \"test/unit/*.test.ts\"",
    "smoke-test": "tsx test/smoke.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.6.0",
    "typescript-eslint": "^8.62.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.9.3"
  }
}
